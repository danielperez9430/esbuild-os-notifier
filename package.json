{
  "name": "esbuild-os-notifier",
  "version": "1.1.2",
  "description": "Esbuild OS Notification Plugin",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielperez9430/esbuild-os-notifier.git"
